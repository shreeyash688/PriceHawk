{
  "manifest_version": 3,
  "name": "PriceHawk",
  "version": "0.1.0",
  "description": "Track prices. Catch deals. Save money.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "PriceHawk",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "*://books.toscrape.com/*",
    "*://*.amazon.com/*",
    "*://*.amazon.in/*",
    "*://*.amazon.co.uk/*",
    "*://*.amazon.ca/*",
    "*://*.amazon.de/*",
    "*://*.amazon.fr/*",
    "*://*.amazon.es/*",
    "*://*.amazon.it/*",
    "*://*.amazon.com.au/*",
    "*://*.flipkart.com/*",
    "*://*.ebay.com/*",
    "*://*.ebay.co.uk/*",
    "*://*.ebay.ca/*",
    "*://*.ebay.com.au/*",
    "*://*.ebay.de/*",
    "*://*.myntra.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
