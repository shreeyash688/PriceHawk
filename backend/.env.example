# Copy this file to ".env" and fill in your own values. NEVER commit ".env".

# --- Email SENDER account (Gmail example: use an "App Password", not your normal password) ---
# Alerts are sent FROM this account TO the email each user enters in the extension.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# --- Currency: every price is stored, shown and emailed in this currency (ISO code) ---
# Prices from stores in other currencies (e.g. amazon.com in USD) are converted.
HOME_CURRENCY=INR
# true = live exchange rates (cached 6 h); false = built-in approximate rates
FX_LIVE_RATES=true

# --- Limits ---
# How many products one email address may track
MAX_PRODUCTS_PER_EMAIL=20

# --- Monitoring ---
# Seconds between background checks. Shopping sites block servers that ask too often:
# 900 (15 min) or more is sensible; Demo mode doesn't need short intervals.
CHECK_INTERVAL_SECONDS=900
# After a CAPTCHA/block, leave that product alone for this many minutes
BLOCKED_RETRY_MINUTES=30

# --- Demo mode: lets you fake a price drop to show the email alert ---
DEMO_MODE=true

# --- Optional: restrict API access to ONE extension (find the ID on chrome://extensions) ---
EXTENSION_ID=

# --- Supabase database ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_server_side_secret_key